-- KeyUI.lua (Professional Key System)
local KEY = "PrimoOnTop"
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = game.Players.LocalPlayer
local TweenService = game:GetService("TweenService")

-- Wait for server RemoteEvent
local KeyCheckEvent = ReplicatedStorage:WaitForChild("KeyCheckEvent")

-- Create ScreenGui
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Parent = player:WaitForChild("PlayerGui")

-- Frame
local Frame = Instance.new("Frame", ScreenGui)
Frame.Size = UDim2.new(0, 300, 0, 150)
Frame.Position = UDim2.new(0.5, -150, 0.5, -75)
Frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
Frame.BorderSizePixel = 0
Frame.AnchorPoint = Vector2.new(0.5, 0.5)

-- Animate Frame fade-in
Frame.BackgroundTransparency = 1
TweenService:Create(Frame, TweenInfo.new(0.5), {BackgroundTransparency = 0}):Play()

-- TextBox
local TextBox = Instance.new("TextBox", Frame)
TextBox.Size = UDim2.new(1, -20, 0, 40)
TextBox.Position = UDim2.new(0, 10, 0, 20)
TextBox.PlaceholderText = "Enter Key"
TextBox.Text = ""
TextBox.TextScaled = true
TextBox.ClearTextOnFocus = true

-- Submit Button
local Button = Instance.new("TextButton", Frame)
Button.Size = UDim2.new(1, -20, 0, 40)
Button.Position = UDim2.new(0, 10, 0, 80)
Button.Text = "Submit Key"
Button.BackgroundColor3 = Color3.fromRGB(60, 150, 60)
Button.TextScaled = true

-- Key submission function
Button.MouseButton1Click:Connect(function()
    local inputKey = TextBox.Text
    if inputKey == "" then
        TextBox.PlaceholderText = "Please enter key!"
        return
    end
    KeyCheckEvent:FireServer(inputKey)
end)

-- Server response
KeyCheckEvent.OnClientEvent:Connect(function(isValid)
    if isValid then
        -- Animate Frame fade-out
        TweenService:Create(Frame, TweenInfo.new(0.5), {BackgroundTransparency = 1}):Play()
        wait(0.5)
        Frame:Destroy()
        print("Access Granted ✅")

        -- 🔒 Load main script from GitHub safely
        local success, err = pcall(function()
            loadstring(game:HttpGet("https://raw.githubusercontent.com/primoontop/primo.Lua./refs/heads/main/Primo.Lua. "))()
        end)
        if not success then
            warn("Failed to run main script: " .. err)
        end

    else
        -- Invalid key feedback
        TextBox.Text = ""
        TextBox.PlaceholderText = "Invalid Key!"
        warn("Access Denied ❌")
        -- Optional: shake animation
        local originalPos = Frame.Position
        for i = 1, 3 do
            Frame.Position = Frame.Position + UDim2.new(0, 5, 0, 0)
            wait(0.05)
            Frame.Position = Frame.Position - UDim2.new(0, 10, 0, 0)
            wait(0.05)
            Frame.Position = originalPos
        end
    end
end)
